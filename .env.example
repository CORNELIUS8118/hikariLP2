# ============================================================
# 光回線LP 環境変数設定
# ============================================================
# このファイルをコピーして .env.local を作成してください
# cp .env.example .env.local
# ============================================================

# Google Apps Script Web App URL（必須）
# GASをウェブアプリとして公開したURLを設定
GAS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# 公式LINE URL（必須）
# サーバーサイドのみで使用。クライアントのJSバンドルには含まれません。
# 申込意思A/Bのユーザーのみに返却されます。
LINE_URL=https://lin.ee/XXXXXXX

# キャンペーン名（任意）
# ブラウザのタイトルバーに表示されます
# 省略時: 光回線「まるっと10ヶ月」無料キャンペーン
NEXT_PUBLIC_CAMPAIGN_NAME=光回線「まるっと10ヶ月」無料キャンペーン

# 申込確認メール送信用SMTP設定（必須）
# Gmailを利用する場合、SMTP_PASSには通常のGoogleアカウントパスワードではなく
# 「Googleアプリパスワード」を発行して設定してください。
# サーバーサイドのみで使用。クライアントのJSバンドルには含まれません。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password

# 申込確認メールの送信元アドレス（必須）
# 通常はSMTP_USERと同じアドレスを設定します
MAIL_FROM=your-address@gmail.com
