# ============================================================
# 光回線LP 環境変数設定
# ============================================================
# このファイルをコピーして .env.local を作成してください
# cp .env.example .env.local
# ============================================================

# Google Apps Script Web App URL（必須）
# GASをウェブアプリとして公開したURLを設定
GAS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# 公式LINE URL（必須）
# サーバーサイドのみで使用。クライアントのJSバンドルには含まれません。
# 申込意思A/Bのユーザーのみに返却されます。
LINE_URL=https://lin.ee/XXXXXXX

# キャンペーン名（任意）
# ブラウザのタイトルバーに表示されます
# 省略時: 光回線「まるっと10ヶ月」無料キャンペーン
NEXT_PUBLIC_CAMPAIGN_NAME=光回線「まるっと10ヶ月」無料キャンペーン
